# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma Database Configuration
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# For Supabase, use your connection string from the dashboard:
# https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://postgres:password@your-project.supabase.co:5432/postgres"

# Better Auth Configuration
# Generate a random secret: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# For production, use your Vercel app URL
BETTER_AUTH_SECRET="your-production-secret-key-here"
BETTER_AUTH_URL="https://your-app.vercel.app"
NEXT_PUBLIC_BETTER_AUTH_URL="https://your-app.vercel.app"

# OAuth Providers (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Services (Optional - for AI processing features)
# Get API keys from respective providers:
# OpenAI: https://platform.openai.com/api-keys
# Google AI: https://makersuite.google.com/app/apikey
# Anthropic: https://console.anthropic.com/
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""

# Hugging Face for Embeddings (Required)
# Get token from: https://huggingface.co/settings/tokens
# Using EmbeddingGemma models: google/embeddinggemma-300m
HUGGINGFACE_API_KEY="hf_your-token-here"

# Production Monitoring and Alerts
# Slack webhook for error notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/your/webhook/url"

# Email for critical alerts
ALERT_EMAIL="admin@yourdomain.com"

# Secret for cron job authentication
CRON_SECRET="your-cron-secret-key"

# Performance monitoring
VERCEL_ANALYTICS_ID="your-vercel-analytics-id"
