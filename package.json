{
  "name": "lecoder-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:production": "next build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:studio": "prisma studio",
    "dev": "next dev --turbo",
    "postinstall": "prisma generate",
    "preview": "next build && next start",
    "start": "next start",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "jest --testPathPatterns=performance",
    "test:all": "npm run test && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "docs:generate": "tsx scripts/generate-api-docs.ts",
    "docs:dev": "next dev",
    "docs:build": "next build",
    "analyze": "ANALYZE=true npm run build",
    "performance:audit": "tsx scripts/performance-audit.ts",
    "deploy:staging": "tsx scripts/deployment-automation.ts staging",
    "deploy:production": "tsx scripts/deployment-automation.ts production --rollback-on-failure",
    "deploy:db": "tsx scripts/deploy-database.ts",
    "monitor:health": "tsx scripts/database-monitoring.ts health",
    "monitor:cleanup": "tsx scripts/database-monitoring.ts cleanup",
    "turbo:build": "turbo run build --no-daemon"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.12",
    "@ai-sdk/google": "^2.0.12",
    "@ai-sdk/openai": "^2.0.24",
    "@next/bundle-analyzer": "^15.5.3",
    "@prisma/client": "^6.5.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ioredis": "^4.28.10",
    "@types/jszip": "^3.4.0",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "ai": "^5.0.33",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.3.8",
    "clsx": "^2.1.1",
    "fumadocs-core": "^15.7.9",
    "fumadocs-mdx": "^11.8.3",
    "fumadocs-ui": "^15.7.9",
    "ioredis": "^5.7.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.542.0",
    "multer": "^2.0.2",
    "next": "^15.2.3",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "lint-staged": "^16.1.6",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "npm@11.5.1",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "jest --findRelatedTests --passWithNoTests --bail"
    ],
    "*.{json,md}": ["biome format --write --no-errors-on-unmatched"],
    "*.{css,scss}": ["biome format --write --no-errors-on-unmatched"]
  }
}
